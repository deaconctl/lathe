#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

channel=$(<crates/zed/RELEASE_CHANNEL)
target_dir="${CARGO_TARGET_DIR:-target}"

suffix=""
if [ "$channel" != "stable" ]; then
    suffix="-$channel"
fi

# Resolve names by channel
case "$channel" in
    stable)
        app_name="Omega"
        app_id="dev.omega.omega"
        ;;
    preview)
        app_name="Omega Preview"
        app_id="dev.omega.omega-Preview"
        ;;
    beta)
        app_name="Omega Beta"
        app_id="dev.omega.omega-Beta"
        ;;
    nightly)
        app_name="Omega Nightly"
        app_id="dev.omega.omega-Nightly"
        ;;
    *)
        app_name="Omega Dev"
        app_id="dev.omega.omega-Dev"
        ;;
esac

# Find the tarball from package-fork-linux output
tarball=$(ls "${target_dir}/release"/Omega-*-linux.tar.gz 2>/dev/null | head -1)

if [ -z "$tarball" ]; then
    echo "Error: Linux tarball not found in ${target_dir}/release/"
    echo "Run 'script/build-fork-linux && script/package-fork-linux' first."
    exit 1
fi

install_dir="${HOME}/.local/share/omega${suffix}"
bin_dir="${HOME}/.local/bin"
desktop_dir="${HOME}/.local/share/applications"
icon_dir_512="${HOME}/.local/share/icons/hicolor/512x512/apps"
icon_dir_1024="${HOME}/.local/share/icons/hicolor/1024x1024/apps"

echo "=== Installing ${app_name} ==="
echo "  From: ${tarball}"
echo "  To:   ${install_dir}"

# Clean previous installation
if [ -d "$install_dir" ]; then
    echo "Removing existing installation..."
    rm -rf "$install_dir"
fi

# Extract to a temp dir first
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT

tar -xzf "$tarball" -C "$temp_dir"

# Move app directory into place
mkdir -p "$install_dir"
mv "$temp_dir/omega${suffix}.app"/* "$install_dir/"

# Symlink CLI to ~/.local/bin
mkdir -p "$bin_dir"
ln -sf "${install_dir}/bin/omega" "${bin_dir}/omega"

# Install .desktop file system-wide for the user
mkdir -p "$desktop_dir"
if [ -f "${install_dir}/share/applications/${app_id}.desktop" ]; then
    # Update paths in .desktop to point to the installed location
    sed "s|Exec=omega|Exec=${install_dir}/bin/omega|g" \
        "${install_dir}/share/applications/${app_id}.desktop" \
        > "${desktop_dir}/${app_id}.desktop"
    chmod +x "${desktop_dir}/${app_id}.desktop"
fi

# Install icons
mkdir -p "$icon_dir_512" "$icon_dir_1024"
if [ -f "${install_dir}/share/icons/hicolor/512x512/apps/omega.png" ]; then
    cp "${install_dir}/share/icons/hicolor/512x512/apps/omega.png" "${icon_dir_512}/omega.png"
fi
if [ -f "${install_dir}/share/icons/hicolor/1024x1024/apps/omega.png" ]; then
    cp "${install_dir}/share/icons/hicolor/1024x1024/apps/omega.png" "${icon_dir_1024}/omega.png"
fi

# Update desktop database if available
if command -v update-desktop-database &>/dev/null; then
    update-desktop-database "$desktop_dir" 2>/dev/null || true
fi

# Update icon cache if available
if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache "${HOME}/.local/share/icons/hicolor" 2>/dev/null || true
fi

echo ""
echo "=== Installed ==="
echo "  App:     ${install_dir}"
echo "  CLI:     ${bin_dir}/omega"
echo "  Desktop: ${desktop_dir}/${app_id}.desktop"
echo ""

# Check if ~/.local/bin is on PATH
if ! echo "$PATH" | tr ':' '\n' | grep -q "^${bin_dir}$"; then
    echo "Note: ${bin_dir} is not on your PATH."
    echo "Add it with:"
    echo "  export PATH=\"${bin_dir}:\$PATH\""
    echo ""
fi

echo "Launch from your application menu or run:"
echo "  omega"
echo ""
echo "Note: This fork installs as '${app_name}' and runs alongside stock Zed."
